# Normalize line endings to LF in the repo and the working tree.
* text=auto eol=lf

# The final tab is the empty deferred-phase field of a completed check.
docs/port/forge-engine-tests.tsv whitespace=-blank-at-eol

# Binary assets: never touch line endings.
*.glb binary
*.gltf binary
*.ktx2 binary
*.png binary
*.jpg binary
*.webp binary
*.wav binary
*.ogg binary
*.mp3 binary
*.bin binary
*.wasm binary
