{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open Editor",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/open-dev-server.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Open Editor (Reference)",
      "detail": "A scratch copy of Games/ForgeReference/webgpu-scenes (refreshed when the server starts), L03 in the editor on 5183",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/open-dev-server.ps1",
        "-Path",
        "/?editor&level=content/levels/L03",
        "-Project",
        "${env:TEMP}/forge-webgpu-reference-editor/webgpu-scenes",
        "-MirrorFrom",
        "${workspaceFolder}/../Games/ForgeReference/webgpu-scenes"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Stop Dev Server",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/stop-dev-server.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Build Production",
      "type": "npm",
      "script": "build",
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
