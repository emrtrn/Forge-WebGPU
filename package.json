{
  "name": "forge-webgpu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p tsconfig.smoke.json",
    "verify:layers": "node tools/verify-layers.ts",
    "verify:file-size": "node tools/verify-file-size.ts",
    "verify:node-load": "node tools/verify-node-load.ts",
    "verify:assets": "node tools/verify-assets.ts",
    "assets:index": "node tools/asset-index.ts",
    "bench:level": "node --expose-gc tools/bench-level.ts",
    "forge": "node tools/forge.ts",
    "create-project": "node tools/create-project.ts",
    "world:random": "node tools/world-random.ts",
    "world:brief": "node tools/world-brief.ts",
    "import:forge": "node tools/import-forge.ts",
    "check:projects": "node tools/check-projects.ts",
    "sdk:snapshot": "node tools/sdk-api.ts write",
    "verify:sdk-api": "node tools/sdk-api.ts verify",
    "port:forge-tests": "node tools/port-forge-tests.ts",
    "port:forge": "node tools/port-forge.ts",
    "test": "vitest run",
    "smoke:render": "playwright test -c tests/smoke/playwright.config.ts",
    "measure:sky-capture": "playwright test -c tests/smoke/measure.config.ts",
    "build": "vite build",
    "gate": "npm run typecheck && npm run verify:layers && npm run verify:file-size && npm run verify:node-load && npm run verify:assets && npm run verify:sdk-api && npm run check:projects && npm run test && npm run build"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "@recast-navigation/core": "0.43.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.0.0",
    "@types/three": "0.187.0",
    "dependency-cruiser": "^18.7.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.5",
    "vitest": "^5.1.0"
  }
}
